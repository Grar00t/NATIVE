<Window x:Class="Niyah.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NATIVE" Width="870" Height="440" MinWidth="640" MinHeight="340"
        Background="#F7F8F6" Foreground="#1C2624" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Click="Open_Click"
                    Padding="14,5" Content="{StaticResource Open}"/>
            <TextBlock Text="{StaticResource Heading}" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Click="Search_Click"
                    Content="{StaticResource Search}" Padding="18,5" IsDefault="True"/>
            <CheckBox x:Name="Exact" DockPanel.Dock="Right" Margin="12,0"
                      VerticalAlignment="Center" Content="{StaticResource Exact}"/>
            <CheckBox x:Name="MatchAny" DockPanel.Dock="Right" Margin="0,0,8,0"
                      VerticalAlignment="Center" Content="{StaticResource MatchAnyLabel}"/>
            <TextBox x:Name="Query" Padding="8,5" AutomationProperties.Name="{StaticResource QueryName}"
                     VerticalContentAlignment="Center"/>
        </DockPanel>
        <DataGrid x:Name="Results" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                  ColumnHeaderHeight="32" Background="White" BorderBrush="#C5CECA"
                  HorizontalGridLinesBrush="#E2E7E4" AlternatingRowBackground="#F5F8F6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="42"/>
                <DataGridTextColumn Header="{StaticResource Title}" Binding="{Binding Title}" Width="1.6*"/>
                <DataGridTextColumn Header="{StaticResource Source}" Binding="{Binding Source}" Width="2*"/>
                <DataGridTextColumn Header="{StaticResource Score}" Binding="{Binding Score, StringFormat=F2}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
